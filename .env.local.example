# ─────────────────────────────────────────────────────────────────────────────
# FrontLoop: environment template
#
#   cp .env.local.example .env.local      # then fill in every value
#
# Validated by src/server/env.ts on first access. Malformed values throw; there
# are no fallback defaults for secrets. Never commit the filled-in copy.
# In production set these in the Vercel project settings, not in a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core database ────────────────────────────────────────────────────────────
# MongoDB Atlas SRV string. Atlas clusters are replica sets (required for change
# streams and multi-document transactions). URL-encode special chars in the password.
# Local dev alternative: mongodb://127.0.0.1:27017/frontloop?replicaSet=rs0
# Billing fulfilment uses a transaction, so local Mongo must run as a replica set
# (`mongod --replSet rs0`, then `rs.initiate()` once in mongosh).
MONGODB_URI=mongodb://127.0.0.1:27017/frontloop?replicaSet=rs0
MONGODB_DB=frontloop

# ── Auth & encryption ────────────────────────────────────────────────────────
# Signs session JWTs (HS256). Min 32 chars. Rotating it logs everyone out.
#   openssl rand -base64 48
AUTH_SECRET=

# AES-256-GCM key for WhatsApp access tokens at rest. Exactly 32 bytes, base64.
# Rotating it makes stored tokens undecryptable; tenants must reconnect.
#   openssl rand -base64 32
TOKEN_ENC_KEY=

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# Meta for Developers → your app → App settings → Basic.
META_APP_ID=
# Signs every webhook (x-hub-signature-256). The webhook returns 500 if unset.
META_APP_SECRET=
# Your own random string, min 24 chars; paste the same value into the
# WhatsApp → Configuration → Webhook "Verify token" field.
#   openssl rand -hex 24
META_VERIFY_TOKEN=
# Graph API version for outbound sends. Meta retires versions ~2 years after
# release; check developers.facebook.com/docs/graph-api/changelog before deploys.
GRAPH_API_VERSION=v21.0

# ── Cron ─────────────────────────────────────────────────────────────────────
# Bearer token for /api/cron/*. Min 24 chars. There is no vercel.json cron (the
# Hobby tier allows daily jobs only), so schedule an external caller such as
# cron-job.org or Upstash QStash every 1-2 minutes:
#   GET https://<your-domain>/api/cron/reply-sweeper
#   Authorization: Bearer <CRON_SECRET>
#   openssl rand -hex 32
CRON_SECRET=

# ── AI fallback engine (tried in order; at least one recommended) ────────────
# Tier 1: Google AI Studio: aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Tier 2: Groq: console.groq.com/keys
GROQ_API_KEY=
# Tier 3: Cerebras: cloud.cerebras.ai
CEREBRAS_API_KEY=
# With none set, every customer receives the knowledge base's static fallback reply.

# ── Billing (Cashfree Payments) ──────────────────────────────────────────────
# Cashfree dashboard → Developers → API keys. Use TEST keys outside production.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional; pinned API version (default 2023-08-01).
# CASHFREE_API_VERSION=2023-08-01
# Selects Cashfree sandbox vs live API; required for billing. sandbox | production
CASHFREE_ENV=sandbox

# ── Public landing page ──────────────────────────────────────────────────────
# WhatsApp number of the live demo bot: digits only, with country code, no "+"
# (e.g. 919812345678). Exposed to the browser. Leave empty to hide the demo CTA.
NEXT_PUBLIC_DEMO_WHATSAPP_NUMBER=

# ── Transactional email ──────────────────────────────────────────────────────
# Resend (resend.com/api-keys): password reset emails.
RESEND_API_KEY=

# ── Local tooling only (scripts/seed-tenant.ts, scripts/test-webhook-flow.ts) ─
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=          # required when NODE_ENV=production
# SEED_PHONE_NUMBER_ID=100000000000001
# SEED_WA_ACCESS_TOKEN=         # real Meta token → seeded tenant can send replies
# WEBHOOK_BASE_URL=http://localhost:3000
