// ============================================================
// PRISMA SCHEMA FOR DEAD STOCK MARKETPLACE
// ============================================================
// Developer Note:
// Uncomment and run the SQL database trigger at the bottom of the Supabase migration to enforce an auto-sync mechanism that ensures a seamless row-per-shop join mapping on public pages.
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shop {
  id                       String             @id @db.Uuid
  shop_name                String
  owner_phone              String
  contact_number           String?
  location_address         String?
  city                     String?
  district                 String?
  state                    String?
  country                  String?
  is_blocked               Boolean            @default(false)
  industry_type            String
  meta_access_token        String?
  meta_phone_number_id     String?
  meta_business_account_id String?
  meta_template_name       String?
  google_maps_url          String?
  marketplace_active       Boolean            @default(true)
  created_at               DateTime           @default(now()) @db.Timestamptz

  // Relations
  deadStockProducts        DeadStockProduct[]

  @@map("shops")
}

model DeadStockProduct {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shop_id             String   @db.Uuid
  product_name        String
  original_price      Decimal  @db.Decimal(12, 2)
  clearance_price     Decimal  @db.Decimal(12, 2)
  discount_percentage Int      @default(0)
  category            String
  description         String?
  condition_notes     String?
  images              String[] @default([])
  is_cleared          Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz

  // Relations
  shop                Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@index([shop_id])
  @@index([category])
  @@index([is_cleared])
  @@index([clearance_price])
  @@index([discount_percentage(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@index([is_cleared, created_at(sort: Desc)])
  @@map("dead_stock_products")
}
