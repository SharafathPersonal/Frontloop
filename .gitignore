# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/service/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Block service local variables & build nodes
service/node_modules/
service/.env
service/.env.local

# Scratch scripts & temporary audit logs
scratch*.ts
scratch*.mjs
scratch*.js
merge_sql.js
migrate_files.js
fix-layouts.js
patch_settings.js
query_user.js
error.log
lint_errors.txt
